# Tools share the project's root .env. The variables below are
# the ones the tools read; the bot itself reads more (see
# caldanai/environment.py). Copy any missing ones into your
# repo-root .env (NOT this file — this is just documentation).

# Mongo cluster URI. Same as the bot uses. Required.
DB_CONNECTION=mongodb+srv://USER:PASS@CLUSTER/

# Name of the LIVE Mongo database. Tools always target this DB
# (not the test one), so set it to wherever your production
# guild's config / auth documents actually live. Defaults to
# "caldanai" if unset, but the canonical deployment uses a
# different name — set it explicitly.
LIVE_DB_NAME=your_live_db_name_here

# (Optional) Test database name, used only by the bot itself
# when STAGE=TEST. Tools never read this. Defaults to
# "caldanai_test".
# TEST_DB_NAME=your_test_db_name_here
